rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if true;
      allow list, write: if request.auth != null && request.auth.uid == userId;
      
      // Explicitly allow public visitors to read & create web chat messages
      match /webChat/{msgId} {
        allow read, create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Explicitly protect all other business subcollections (only owner can read/write)
      match /leads/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /audits/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /emails/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /reviews/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /smsLog/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /campaigns/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /contracts/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /notifications/{docId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    }

    match /system/adminSettings {
      allow read, write: if request.auth != null && request.auth.token.email == 'prometheonderrius@gmail.com';
    }

    match /apiLogs/{logId} {
      allow read: if request.auth != null && request.auth.token.email == 'prometheonderrius@gmail.com';
      allow write: if true;
    }
  }
}
