{
  "tables": [
    {
      "name": "clients",
      "description": "Stores contact details of lawn care and landscaping clients.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": "PRIMARY KEY AUTOINCREMENT"
        },
        {
          "name": "name",
          "type": "TEXT",
          "constraints": "NOT NULL"
        },
        {
          "name": "phone",
          "type": "TEXT",
          "constraints": null
        },
        {
          "name": "address",
          "type": "TEXT",
          "constraints": null
        },
        {
          "name": "status",
          "type": "TEXT",
          "constraints": "DEFAULT 'Active'"
        }
      ],
      "sample_records": [
        {
          "id": 1,
