          "address": "89 Pine Rd",
          "status": "Active"
        },
        {
          "id": 3,
          "name": "Oakridge HOA",
          "phone": "555-8811",
          "address": "400 Oakridge Blvd",
          "status": "Active"
        }
      ]
    },
    {
      "name": "jobs",
      "description": "Tracks landscaping jobs, schedules, prices, and status.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": "PRIMARY KEY AUTOINCREMENT"
        },
        {
          "name": "client_id",
          "type": "INTEGER",
          "constraints": "REFERENCES clients(id)"
        },
        {
          "name": "service_type",
          "type": "TEXT",
          "constraints": null
        },
        {
          "name": "scheduled_date",
          "type": "TEXT",
          "constraints": null
        },
        {
          "name": "price",
          "type": "REAL",
          "constraints": null
        },
        {
          "name": "status",
          "type": "TEXT",
          "constraints": null
        }
      ],
      "sample_records": [
        {
          "id": 1,
