        }
      ]
    },
    {
      "name": "crew_assignments",
      "description": "Assigns working crews to scheduled jobs.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": "PRIMARY KEY AUTOINCREMENT"
        },
        {
          "name": "job_id",
          "type": "INTEGER",
          "constraints": "REFERENCES jobs(id)"
        },
        {
          "name": "crew_name",
          "type": "TEXT",
          "constraints": null
        },
        {
          "name": "lead_worker",
          "type": "TEXT",
          "constraints": null
        }
      ],
      "sample_records": [
        {
