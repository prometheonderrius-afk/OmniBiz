{
  "name": "alias-sync",
  "version": "1.0.0",
  "description": "Zero-config CLI tool to synchronize tsconfig.json path aliases to Vite, Jest, and ESLint flat configs.",
  "main": "dist/cli.js",
  "bin": {
    "alias-sync": "./dist/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "typescript",
    "alias",
    "path-mapping",
    "vite",
    "jest",
    "eslint",
    "tsconfig"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
